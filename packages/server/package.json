{
  "name": "@base-multiplayer-game/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "test:integration": "RUN_INTEGRATION=1 vitest run"
  },
  "dependencies": {
    "@base-multiplayer-game/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "fastify": "^5.0.0",
    "@fastify/websocket": "^11.0.0",
    "nanoid": "^5.0.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
