{
  "mcpServers": {
    "game-debug": {
      "type": "http",
      "url": "http://localhost:4400/debug-mcp"
    },
    "angular": {
      "command": "pnpm",
      "args": ["--dir", "packages/client", "exec", "ng", "mcp"]
    },
    "playwright": {
      "command": "playwright-mcp",
      "args": ["--headless", "--browser", "chromium", "--viewport-size", "1280,800", "--output-dir", ".qa/screenshots"]
    }
  }
}
