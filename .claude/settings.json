{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(tmux list-panes:*)",
      "Bash(tmux capture-pane:*)",
      "Bash(ls:*)",
      "Bash(pnpm:*)",
      "Bash(node:*)",
      "Bash(chmod:*)",
      "Bash(npx tsc:*)",
      "Bash(npx ng:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsx:*)",
      "Bash(npm run:*)",
      "Bash(grep:*)",
      "Bash(curl:*)",
      "Bash(ss:*)",
      "Bash(netstat:*)",
      "Bash(find:*)",
      "Bash(pgrep:*)",
      "Bash(cat:*)",
      "Bash(wc:*)",
      "Bash(./validate.sh:*)",
      "Bash(./run.sh:*)",
      "Bash(scripts/docs-index.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git remote -v)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git restore:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git stash:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git tag:*)",
      "WebSearch",
      "WebFetch(domain:angular.dev)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:github.com)",
      "mcp__game-debug__*",
      "mcp__angular__*"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": ["game-debug", "angular"]
}
